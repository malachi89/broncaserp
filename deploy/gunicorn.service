[Unit]
Description=El Broncas ERP Gunicorn
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/broncaserp
EnvironmentFile=/opt/broncaserp/.env
ExecStart=/opt/broncaserp/.venv/bin/gunicorn broncaserp.wsgi:application --bind 127.0.0.1:8000 --workers 2 --timeout 60
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

